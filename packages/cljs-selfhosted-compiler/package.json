{
  "name": "@live-codes/cljs-selfhosted-compiler",
  "version": "0.1.1",
  "description": "The self-hosted ClojureScript compiler, packaged for LiveCodes: compile ClojureScript in a classic web worker and run the resulting JavaScript in the page.",
  "type": "module",
  "main": "./dist/index.iife.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.iife.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs",
    "start": "node test/serve.mjs",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/live-codes/browser-clojurescript"
  },
  "license": "EPL-1.0",
  "engines": {
    "node": ">=18"
  }
}
